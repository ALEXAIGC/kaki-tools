#!/usr/bin/env bash
set -euo pipefail
app='/Applications/Kaki Tools.app'
signing_requirement=__KAKI_SIGNING_REQUIREMENT__
echo '此工具仅用于首次更换签名后的授权修复。'
echo '只重置 Kaki Tools 的辅助功能和录屏授权，不修改其他应用。'
if ! /usr/bin/codesign --verify --deep --strict -R "=$signing_requirement" "$app"; then
  echo '请先把此安装包中的 Kaki Tools 安装到“应用程序”，再运行本工具。'
  read -r -p '按回车关闭…' _reply
  exit 1
fi
pattern='^/Applications/Kaki Tools[.]app/Contents/MacOS/Kaki Tools$'
if /usr/bin/pgrep -f "$pattern" >/dev/null; then
  /usr/bin/pkill -TERM -f "$pattern"
  for _attempt in 1 2 3 4 5 6 7 8; do
    /usr/bin/pgrep -f "$pattern" >/dev/null || break
    sleep 1
  done
  if /usr/bin/pgrep -f "$pattern" >/dev/null; then
    echo '程序尚未退出，请从菜单栏 K 选择“退出 Kaki Tools”后重试。'
    read -r -p '按回车关闭…' _reply
    exit 1
  fi
fi
/usr/bin/tccutil reset Accessibility com.openclaw.kakitools
/usr/bin/tccutil reset ScreenCapture com.openclaw.kakitools
/usr/bin/open -a "$app"
/usr/bin/open 'x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility'
echo '请在已打开的“辅助功能”设置中允许 Kaki Tools。'
echo '然后按 ⌘⇧2，根据系统提示重新开启录屏权限。'
echo '系统若要求退出并重新打开，请照做。'
read -r -p '按回车关闭此窗口…' _reply
