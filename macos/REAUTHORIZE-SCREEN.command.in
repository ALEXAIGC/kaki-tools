#!/usr/bin/env bash
set -euo pipefail
app='/Applications/Kaki Tools.app'
bundle_id='com.openclaw.kakitools'
signing_requirement=__KAKI_SIGNING_REQUIREMENT__
fail() {
  echo "$*" >&2
  read -r -p '按回车关闭…' _reply || true
  exit 1
}
running_instances() {
  /usr/bin/osascript -l JavaScript <<'JAVASCRIPT'
ObjC.import('AppKit');
const applications = $.NSWorkspace.sharedWorkspace.runningApplications;
const instances = [];
for (let index = 0; index < applications.count; index++) {
  const application = applications.objectAtIndex(index);
  if (ObjC.unwrap(application.bundleIdentifier) === 'com.openclaw.kakitools') {
    const path = application.bundleURL ? ObjC.unwrap(application.bundleURL.path) : '路径未知';
    instances.push('PID ' + application.processIdentifier + ' · ' + path);
  }
}
instances.join('\n');
JAVASCRIPT
}
echo 'Kaki Tools · 修复截图权限'
echo '仅用于录屏开关已经开启、但截图仍提示授权的情况；正常更新无需运行。'
echo '只重置 Kaki Tools 的录屏授权，不修改辅助功能、其他应用或剪贴板历史。'
identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null || true)
[ "$identifier" = "$bundle_id" ] || fail '请先把此安装包中的 Kaki Tools 安装到“应用程序”。'
if ! /usr/bin/codesign --verify --deep --strict -R "=$signing_requirement" "$app"; then
  fail '应用签名与此安装包不匹配，请先安装此包中的 Kaki Tools，再运行本工具。'
fi
echo "安装位置：$app"
instances=$(running_instances) || fail '无法检查正在运行的 Kaki Tools，未重置任何权限。'
if [ -n "$instances" ]; then
  printf '以下 Kaki Tools 仍在运行：\n%s\n' "$instances"
  echo '请从各个菜单栏 K 选择“退出 Kaki Tools”；关闭窗口不代表退出。'
  read -r -p '全部退出后，按回车修复录屏授权；按 Control+C 取消…' _reply
else
  read -r -p '按回车修复录屏授权；按 Control+C 取消…' _reply
fi
instances=$(running_instances) || fail '无法再次检查 Kaki Tools 是否退出，未重置任何权限。'
if [ -n "$instances" ]; then
  printf '仍在运行：\n%s\n' "$instances"
  fail 'Kaki Tools 尚未完全退出，未重置权限。退出全部实例后再运行本工具。'
fi
if ! /usr/bin/tccutil reset ScreenCapture "$bundle_id"; then
  fail '录屏授权重置失败，请保留以上错误信息；本工具不会重试或重置其他权限。'
fi
if ! /usr/bin/open -a "$app"; then
  fail '录屏授权已重置，但应用未能打开。请从“应用程序”手动打开 Kaki Tools，再开启录屏授权。'
fi
if ! /usr/bin/open 'x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture'; then
  echo '请手动打开：系统设置 → 隐私与安全性 → 录屏与系统录音。'
fi
echo '请重新允许 Kaki Tools 录制屏幕。系统若要求退出并重新打开，请照做。'
echo '若列表暂时没有 Kaki Tools，请在软件中尝试一次区域截图，再按系统提示授权。'
echo '授权后从“应用程序”打开此版本，再测试区域截图；不要从安装磁盘或旧副本启动。'
read -r -p '按回车关闭此窗口…' _reply
