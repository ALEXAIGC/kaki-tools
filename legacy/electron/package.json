{
  "name": "kaki-tools",
  "productName": "Kaki Tools",
  "version": "0.10.2",
  "description": "Archived Electron implementation of Kaki Tools; current macOS app is native Swift.",
  "author": "openclaw",
  "main": "main/index.js",
  "scripts": {
    "start": "npm run native:build && electron .",
    "native:build": "bash scripts/build-native.sh",
    "macos:build": "bash scripts/build-macos-native.sh",
    "macos:test": "bash scripts/test-macos-native.sh",
    "macos:dist": "bash scripts/build-macos-native.sh && bash scripts/package-macos-native.sh",
    "macos:deskflow": "bash scripts/package-deskflow-component.sh",
    "deskflow:build": "bash scripts/build-deskflow.sh",
    "icon": "node scripts/gen-app-icon.js",
    "pack": "npm run native:build && npm run deskflow:build && electron-builder --mac dir",
    "release:local": "npm run pack && bash scripts/install-local-update.sh",
    "dist": "npm run native:build && npm run deskflow:build && electron-builder",
    "test": "node --test tests/*.test.js",
    "test:renderer": "electron tests/renderer-performance.cjs",
    "test:image": "electron tests/image-performance.cjs"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.openclaw.kakitools",
    "productName": "Kaki Tools",
    "files": [
      "main/**",
      "renderer/**",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "native/bin/kaki-fast-paste",
        "to": "MacOS/kaki-fast-paste"
      },
      {
        "from": "native/deskflow/deskflow-core",
        "to": "MacOS/deskflow-core"
      },
      {
        "from": "native/deskflow/Frameworks",
        "to": "Frameworks"
      },
      {
        "from": "native/deskflow/PlugIns",
        "to": "PlugIns"
      },
      {
        "from": "native/deskflow/qt.conf",
        "to": "Resources/qt.conf"
      }
    ],
    "mac": {
      "target": "dmg",
      "identity": "Kaki Tools Dev",
      "timestamp": "none",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "lucide": "^1.35.0",
    "pngjs": "^7.0.0"
  },
  "private": true
}
